@FantasyX.Backend_HostAddress = http://localhost:8080

### List teams in a public league
POST {{FantasyX.Backend_HostAddress}}/api/espn/leagues/teams
Content-Type: application/json

{
  "leagueId": 123456,
  "season": 2024
}

### Get a league's standings and current-week matchups
POST {{FantasyX.Backend_HostAddress}}/api/espn/league
Content-Type: application/json

{
  "leagueId": 123456,
  "season": 2024
}

### Import a specific team's roster
POST {{FantasyX.Backend_HostAddress}}/api/espn/team
Content-Type: application/json

{
  "leagueId": 123456,
  "season": 2024,
  "teamId": 1
}

### Get every matchup this week (all teams' rosters and scores, plus who plays whom)
POST {{FantasyX.Backend_HostAddress}}/api/espn/matchups
Content-Type: application/json

{
  "leagueId": 123456,
  "season": 2024
}

### Get a player's detail (season summary, weekly game log, and schedule)
POST {{FantasyX.Backend_HostAddress}}/api/espn/player
Content-Type: application/json

{
  "leagueId": 123456,
  "season": 2024,
  "playerId": 3918298
}

### Get players' weekly points vs ESPN projection (weeks before scoringPeriod); -16026 is a D/ST
POST {{FantasyX.Backend_HostAddress}}/api/espn/player-history
Content-Type: application/json

{
  "leagueId": 123456,
  "season": 2024,
  "scoringPeriod": 5,
  "playerIds": [3918298, 3116406, -16026]
}

###
